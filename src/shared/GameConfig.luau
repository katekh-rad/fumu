--[[
	GameConfig.luau

	Общие константы + тип "гриб в корзине" — то самое runtime-состояние,
	которое отличается от справочника MushroomTypes: там просто "какие
	виды грибов существуют", а тут — "что лежит в корзине конкретного
	игрока прямо сейчас".
]]

local MushroomTypes = require(script.Parent.MushroomTypes)

export type DefectKind = "mold" | "worms"

export type BasketSlot = {
	instanceId: string, -- уникальный id экземпляра гриба (не путать с typeId)
	typeId: MushroomTypes.MushroomTypeId, -- реальный вид — известен серверу,
	-- но клиенту до проверки не показываем!
	pickedUpAt: number, -- os.time() или os.clock(), для статистики/UI
	-- Цвет шляпки именно этого экземпляра (вид + случайный оттенок).
	-- Тот же цвет, что у модели в лесу.
	color: Color3,

	-- Порча конкретного экземпляра (не вида!). Решается при подборе и
	-- хранится только на сервере. Испорченный гриб при разборе
	-- считается несъедобным, даже если сам вид съедобный.
	defect: DefectKind?,
	-- Размер следа: 1 = крупный, 2 = средний, 3 = мелкий.
	-- Лупа уровня N видит следы размером <= N (см. Tools).
	defectSize: number?,
	-- Самый сильный уровень лупы, которым гриб уже осматривали.
	-- 0 = ещё не осматривали.
	inspectedLevel: number,

	-- Решение игрока: true = "беру, считаю съедобным". Только отмеченные
	-- грибы участвуют в подсчёте при подтверждении; неотмеченные
	-- остаются в корзине до следующего разбора.
	kept: boolean?,
}

local GameConfig = {
	-- Множитель к basePoints вида при подтверждении разбора корзины.
	-- Оставлен для будущего баланса (например, бонус за редкие виды).
	scoreMultiplier = 1,

	-- Максимальное время удержания гриба в мире до респавна (секунды),
	-- если игрок его не поднял.
	mushroomRespawnTime = 45,

	-- Радиус взаимодействия "поднять гриб" (studs).
	pickupRadius = 6,

	-- Постепенная порча. Считается по числу уже разобранных грибов:
	-- каждые mushroomsPerStep грибов (≈ одна маленькая корзина) — это
	-- один "шаг". Первые graceSteps шагов порчи нет совсем, дальше шанс
	-- растёт на chancePerStep за шаг, но не выше maxChance.
	-- С настройками ниже: корзины 1-2 чистые, 3-я — 5%, ... 8-я и
	-- дальше — 30%.
	spoilage = {
		mushroomsPerStep = 8,
		graceSteps = 2,
		chancePerStep = 0.05,
		maxChance = 0.30,
		-- Доли размеров следа: крупный / средний / мелкий.
		-- Отсюда точность луп: x5 ≈ 60%, x10 ≈ 85%, x20 = 100%.
		sizeWeights = { 60, 25, 15 },
	},

	-- Разброс оттенка шляпки у каждого гриба (в долях HSV, ±).
	-- Из-за него похожие виды (опёнок / ложный опёнок / белый) иногда
	-- выглядят одинаково, и по цвету уже не всегда угадаешь.
	colorVariation = {
		hue = 0.02,
		saturation = 0.10,
		value = 0.08,
	},

	-- Сколько раз вид должен пройти через разбор, чтобы лупа начала
	-- показывать его название. Если игрок оставил ядовитый гриб, чьё
	-- название уже было видно, вид "забывается" (счётчик в ноль).
	namesAfterConfirms = 2,

	-- Психоделический лес — награда за радужный гриб (см. PsychoMap).
	psycho = {
		-- Шанс, что вместо обычного гриба вырастет радужный (1 из 100)
		rainbowChance = 0.01,
		-- Во сколько раз больше очков дают грибы в психолесу
		scoreMultiplier = 2,
		-- Сколько очков нужно заработать там, чтобы вернуться.
		-- Все грибы психолеса съедобные, поэтому маленькая корзина
		-- (8 грибов) даёт 16 очков — цель в 24 это примерно 1,5 корзины.
		targetScore = 24,
		-- Страховка: дольше этого визит не длится (секунды).
		-- 2 минуты — примерно столько идут 1,5 ходки с корзиной.
		timeLimitSeconds = 120,

		-- Где стоит остров. Далеко в стороне, чтобы с основной карты
		-- его не было видно.
		islandOrigin = Vector3.new(4000, 300, 4000),
		islandRadius = 80,
		treeCount = 16,
		mushroomCount = 40,
		respawnTime = 10,
		-- Базовый салатовый (запасной цвет). Реальный цвет шляпки у
		-- каждого гриба психолеса свой, случайный и яркий.
		mushroomColor = Color3.fromRGB(150, 255, 60),
	},

	-- Тег модели, куда игрок приносит собранные грибы (большая плетёная
	-- корзина, см. SortingBasket.server.luau). По нему её находят и
	-- сервер, и клиент, и модуль зон.
	stationTag = "SortingBasket",

	-- Начальный набор инструментов и корзина у нового игрока.
	startingBasketId = "SMALL",
	startingTools = {} :: { string }, -- пусто — лупу докупают сами
}

return GameConfig
